{
  "name": "@crypto-terminal/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run src",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev"
  },
  "dependencies": {
    "@crypto-terminal/contracts": "1.0.0",
    "@prisma/client": "6.12.0",
    "better-auth": "1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pino-http": "^11.0.0",
    "redis": "^5.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^10.0.0",
    "prisma": "6.12.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
